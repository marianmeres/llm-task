# Only needed for the opt-in live smoke test (`deno task test:live`) or when
# relying on the env-var key fallback instead of passing `apiKey` explicitly.
ANTHROPIC_API_KEY=sk-ant-...

# Azure OpenAI — needed for `deno task test:live:azure`. All three must be set
# or the Azure live case self-ignores. That task grants `--allow-net` unscoped
# because the resource host is yours, not something this repo can hardcode.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=...
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
# Optional: set only for older resources needing the classic deployment route.
# AZURE_OPENAI_API_VERSION=2024-10-21
